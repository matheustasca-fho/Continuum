# Configuração do Banco de Dados na Oracle Cloud Infrastructure (OCI)
# Se for MySQL Server:
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=continuum_db
DB_USER=continuum_user
DB_PASSWORD=sua_senha_segura
DB_CHARSET=utf8mb4

# Se for Oracle Database nativo (usando oci8 / pdo_oci):
# DB_DRIVER=oci
# DB_TNS=//127.0.0.1:1521/XEPDB1

